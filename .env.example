# Токен от @BotFather
BOT_TOKEN=123456789:AA...

# Кто может пользоваться /null, /unnull, /setrep, /addrep (через запятую)
ADMIN_IDS=1457986905

# Где хранить базу SQLite. На хостинге путь должен вести на постоянный диск (volume)
DB_PATH=data/repbot.db

# Либо PostgreSQL — если задан, используется вместо SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Сколько +rep можно выдать за 24 часа
DAILY_REP_LIMIT=3

# Текст плашки, {rep} заменяется на репутацию (до 16 символов, без эмодзи)
TAG_FORMAT=реп{rep}

# Часовой пояс для дат в профиле
TZ_NAME=Europe/Moscow
