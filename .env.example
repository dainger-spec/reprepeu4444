# Скопируйте этот файл в .env (только для запуска на своём компьютере/VPS).
# На хостинге вместо .env задайте эти же переменные в панели: Variables / Environment.

# Токен от @BotFather — единственная обязательная настройка
BOT_TOKEN=

# ID групп, в которых работает бот, через запятую (в остальных он не работает и выходит из них).
# Узнать: добавьте бота в группу и напишите там /chatid. Пример: -1001111111111,-1002222222222
ALLOWED_CHAT_ID=

# Кто может пользоваться /null, /unnull, /setrep, /addrep (через запятую)
ADMIN_IDS=1457986905

# Где хранить базу SQLite (по умолчанию data/repbot.db). Папка должна быть на постоянном диске
# DB_PATH=data/repbot.db

# Либо PostgreSQL — если задан, используется вместо SQLite
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Сколько +rep можно выдать за 24 часа
DAILY_REP_LIMIT=3

# Текст плашки, {rep} заменяется на репутацию (до 16 символов, без эмодзи)
TAG_FORMAT=реп{rep}

# Часовой пояс для дат в профиле
TZ_NAME=Europe/Moscow
